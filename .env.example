# =================================================================
# Ghostfolio Ephemeral Pipeline Configuration
# =================================================================
# NOTE: Infrastructure secrets (POSTGRES_PASSWORD, JWT_SECRET_KEY, 
# ACCESS_TOKEN_SALT) and API tokens are AUTOMATICALLY GENERATED in-memory 
# at startup by the runner script. They are NEVER stored on disk.
#
# The variables below are optional overrides:
# =================================================================

# -----------------------------------------------------------------
# 1. Host Google Drive CSV File Path (:ro volume mount)
# -----------------------------------------------------------------
# Default on Windows G: Drive:
LOCAL_CSV_PATH=G:/My Drive/portfolio_docker_sync.csv

# macOS Example:
# LOCAL_CSV_PATH=/Users/<Username>/Library/CloudStorage/GoogleDrive-<email>/My Drive/portfolio_docker_sync.csv

# Linux Example:
# LOCAL_CSV_PATH=/home/<username>/GoogleDrive/portfolio_docker_sync.csv

# -----------------------------------------------------------------
# 2. Market Data Provider (Default: YAHOO)
# -----------------------------------------------------------------
GHOSTFOLIO_DATA_SOURCE=YAHOO

# -----------------------------------------------------------------
# 3. Sidecar Operational Mode
# 'once'  = Ingest CSV trades once and exit (Default)
# 'watch' = Keep container running and re-import whenever CSV changes
# -----------------------------------------------------------------
SYNC_MODE=once
INITIAL_WAIT_SECONDS=5
HEALTH_CHECK_TIMEOUT=120
POLL_INTERVAL_SECONDS=30
